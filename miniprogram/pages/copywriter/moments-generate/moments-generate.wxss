.studio-page {
  height: 100vh;
  padding: 24rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f7faff 0%, #eef4ff 100%);
  box-sizing: border-box;
}

.studio-stack {
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.studio-hero,
.studio-card {
  box-sizing: border-box;
}

.studio-hero {
  height: 266rpx;
  padding: 32rpx;
  border-radius: 52rpx;
  background: linear-gradient(135deg, #1847d8 0%, #4263eb 58%, #16a3b7 100%);
  box-shadow: 0 22rpx 46rpx rgba(36, 71, 176, 0.2);
}

.studio-card {
  padding: 24rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.91);
  border: 1rpx solid #e3eaf5;
}

.source-card {
  height: 286rpx;
  overflow: hidden;
}

.variant-card {
  height: 242rpx;
}

.angle-card {
  height: 472rpx;
  padding: 26rpx;
  border-radius: 40rpx;
}

.studio-card-cyan {
  background: linear-gradient(180deg, #f3fafd 0%, #ecf7fb 100%);
  border-color: #d6eef3;
}

.studio-hero-kicker {
  font-size: 24rpx;
  line-height: 1.2;
  color: #ddebff;
  font-weight: 600;
}

.studio-hero-title {
  margin-top: 8rpx;
  font-size: 38rpx;
  line-height: 1.25;
  color: #ffffff;
  font-weight: 700;
}

.studio-hero-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #e6f4ff;
}

.section-head,
.bottom-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.section-title {
  font-size: 31rpx;
  line-height: 1.2;
  color: #0f172a;
  font-weight: 700;
}

.section-title-cyan {
  color: #0f3d4a;
}

.section-meta {
  font-size: 19rpx;
  line-height: 1.2;
  color: #98a2b3;
  font-weight: 600;
}

.chip-row {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.source-input {
  width: 100%;
  height: 176rpx;
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.48;
  color: #425466;
  background: transparent;
  box-sizing: border-box;
  padding: 0;
}

.chip-row-double .chip {
  flex: 1;
}

.chip-row-triple .chip {
  flex: 1;
  min-width: 0;
}

.chip {
  min-height: 66rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 700;
  background: #ffffffcc;
  color: #4c6570;
  border: 1rpx solid #d8e9ef;
}

.chip-accent {
  background: linear-gradient(180deg, #315cff 0%, #5b7cff 100%);
  color: #ffffff;
  border-color: transparent;
}

.chip-violet {
  background: #ede7ff;
  color: #7c3aed;
  border-color: transparent;
}

.chip-light {
  background: #ffffffcc;
  color: #4c6570;
  border-color: #d8e9ef;
}

.chip-sky {
  background: #ddf4f8;
  color: #117c8e;
  border-color: #b9e7ef;
}

.chip-teal {
  background: linear-gradient(180deg, #178fa3 0%, #37b4c6 100%);
  color: #ffffff;
  border-color: transparent;
}

.bottom-actions {
  align-items: stretch;
}

.btn,
.btn-secondary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  height: 92rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.btn {
  background: linear-gradient(90deg, #2e5bff 0%, #0fa6b8 100%);
  color: #ffffff;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.92);
  color: #445164;
  border: 1rpx solid #d4dce8;
}

.btn::after,
.btn-secondary::after {
  border: none;
}
