<view class="studio-page">
  <view class="studio-stack">
    <view class="studio-hero">
      <view class="studio-hero-kicker">{{heroCard.kicker}}</view>
      <view class="studio-hero-title">{{heroCard.title}}</view>
      <view class="studio-hero-desc">{{heroCard.description}}</view>
    </view>

    <view class="studio-card source-card">
      <view class="section-head">
        <view class="section-title">{{sourceTitle}}</view>
        <view class="section-meta">{{sourceMeta}}</view>
      </view>
      <textarea
        class="source-input"
        value="{{sourceContext.articleContent}}"
        maxlength="-1"
        cursor-spacing="24"
        auto-height="{{false}}"
        bindinput="handleSourceInput"
      ></textarea>
    </view>

    <view class="studio-card variant-card">
      <view class="section-head">
        <view class="section-title">{{variantTitle}}</view>
      </view>
      <view class="chip-row chip-row-triple" wx:for="{{variantRows}}" wx:for-item="row" wx:key="index">
        <view
          class="{{chipItem.className}}"
          wx:for="{{row}}"
          wx:for-item="chipItem"
          wx:key="id"
          bindtap="selectVariant"
          data-id="{{chipItem.id}}"
          data-value="{{chipItem.text}}"
        >
          {{chipItem.text}}
        </view>
      </view>
    </view>

    <view class="studio-card studio-card-cyan angle-card">
      <view class="section-head">
        <view class="section-title section-title-cyan">{{angleTitle}}</view>
      </view>
      <view class="chip-row chip-row-double" wx:for="{{angleRows}}" wx:for-item="row" wx:key="index">
        <view
          class="{{chipItem.className}}"
          wx:for="{{row}}"
          wx:for-item="chipItem"
          wx:key="id"
          bindtap="selectAngle"
          data-id="{{chipItem.id}}"
          data-value="{{chipItem.text}}"
        >
          {{chipItem.text}}
        </view>
      </view>
    </view>
    <view class="bottom-actions">
      <button class="btn-secondary" bindtap="goBack">返回创作页</button>
      <button class="btn" bindtap="openPreviewPage">生成文案</button>
    </view>
  </view>
</view>
