<view class="editor-page">
  <view class="editor-orb"></view>
  <view class="editor-stack">
    <view class="hero-card">
      <view class="hero-kicker">{{heroCard.kicker}}</view>
      <view class="hero-title">{{heroCard.title}}</view>
      <view class="hero-desc">{{heroCard.description}}</view>
    </view>

    <view class="panel-card panel-card-flex">
      <view class="section-head">
        <view class="section-title">{{previewTitle}}</view>
        <view class="section-meta">{{previewMeta}}</view>
      </view>
      <view class="preview-scroll-wrap">
        <view class="draft-list">
          <view class="draft-track" style="{{draftListStyle}}">
            <view
              class="draft-card {{item.id === selectedDraftId ? 'draft-card-active' : ''}}"
              wx:for="{{rankedDrafts}}"
              wx:key="id"
              bindtap="selectDraft"
              data-id="{{item.id}}"
            >
              <view class="draft-content">{{item.content}}</view>
              <view class="draft-meta">{{item.meta || '首选中 · 优势：开头抓人 + 结构完整 + 生活化表达'}}</view>
            </view>
          </view>
        </view>
        <view class="scroll-rail" bindtap="handleScrollRailTap">
          <view
            class="scroll-thumb"
            style="{{scrollThumbStyle}}"
            catchtouchstart="handleScrollThumbStart"
            catchtouchmove="handleScrollThumbMove"
          ></view>
        </view>
      </view>
    </view>

    <view class="panel-card editor-panel">
      <view class="section-head">
        <view class="section-title">{{editorTitle}}</view>
        <view class="section-meta">{{editorMeta}}</view>
      </view>
      <view class="textarea-shell">
        <textarea
          class="editor-input"
          maxlength="-1"
          value="{{activeContent}}"
          bindinput="handleContentInput"
          placeholder="在这里改语气、结构和结尾动作。"
        ></textarea>
      </view>
    </view>

    <view class="bottom-actions">
      <button class="btn-secondary" bindtap="goBackToGenerate">返回上一层重新生成</button>
      <button class="btn" bindtap="copyCurrent">复制定稿</button>
    </view>
  </view>
</view>
