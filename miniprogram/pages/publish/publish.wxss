.page {
  min-height: 100vh;
  background: #f7f7f9;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.state { padding: 120rpx 24rpx; text-align: center; }
.state-text { display: block; font-size: 26rpx; color: #8a8a8f; }
.state-text.error { color: #c0392b; word-break: break-all; }
.state-btn {
  display: inline-block; margin-top: 32rpx; padding: 18rpx 56rpx;
  background: #1a1a1a; color: #fff; border-radius: 999rpx; font-size: 28rpx;
}

.preview {
  height: 320rpx; border-radius: 20rpx; overflow: hidden;
  background: #ececf0; margin-bottom: 24rpx;
}
.preview-img { width: 100%; height: 100%; }
.preview-holder {
  height: 100%; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.preview-holder-icon { font-size: 56rpx; color: #b0b0b8; line-height: 1; }
.preview-holder-text { margin-top: 14rpx; font-size: 24rpx; color: #a0a0a8; }

.card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 24rpx; }
.label { display: block; font-size: 26rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 16rpx; }
.label-hint { font-weight: 400; font-size: 22rpx; color: #a0a0a8; }

.title-input { font-size: 30rpx; color: #1a1a1a; }
.body-input { width: 100%; min-height: 160rpx; font-size: 28rpx; line-height: 1.6; color: #333; }

.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  padding: 14rpx 30rpx; border-radius: 999rpx;
  background: #f2f2f5; border: 2rpx solid #f2f2f5;
  font-size: 26rpx; color: #55555c;
}
.chip-on { background: #1a1a1a; border-color: #1a1a1a; color: #fff; }

.publish-btn {
  margin-top: 12rpx; padding: 26rpx 0; text-align: center;
  background: #1a1a1a; color: #fff; border-radius: 999rpx;
  font-size: 30rpx; font-weight: 500;
}
.publish-btn.disabled { opacity: 0.45; }
.publish-hint {
  display: block; margin-top: 18rpx; text-align: center;
  font-size: 22rpx; color: #a0a0a8;
}
