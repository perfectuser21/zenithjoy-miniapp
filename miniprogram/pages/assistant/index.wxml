<view class="p-page">
  <view class="p-shell" style="padding-top: {{statusBarHeight + 16}}px;">
    <view class="assistant-head">
      <view class="assistant-head-left">
        <view class="assistant-kicker">AI CHAT HOME</view>
        <view class="assistant-title">{{pageTitle}}</view>
      </view>
      <view class="assistant-state">
        <view class="assistant-state-label">{{onlineState}}</view>
        <view class="assistant-state-meta">{{onlineMeta}}</view>
      </view>
    </view>

    <view class="assistant-panel">
      <view class="assistant-panel-title">{{previewTitle}}</view>
      <view class="assistant-message-list">
        <block wx:for="{{messages}}" wx:key="id">
          <view class="assistant-bubble-row assistant-bubble-row-{{item.role}}">
            <view wx:if="{{item.role === 'ai'}}" class="assistant-avatar">AI</view>
            <view class="assistant-bubble assistant-bubble-{{item.role}}">{{item.text}}</view>
          </view>
        </block>
      </view>
      <view wx:if="{{showStarterCta}}" class="assistant-cta-row">
        <view class="assistant-cta" bindtap="openTopicPlanner">{{ctaText}}</view>
      </view>
    </view>

    <view class="assistant-input-row">
      <input
        class="assistant-input"
        type="text"
        placeholder="{{inputPlaceholder}}"
        value="{{draftMessage}}"
        bindinput="handleDraftInput"
        confirm-type="send"
        bindconfirm="handleSend"
      />
      <view class="assistant-send{{draftMessage ? '' : ' assistant-send-disabled'}}" bindtap="handleSend">发送</view>
    </view>
  </view>
</view>
