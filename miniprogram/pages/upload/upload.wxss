.page {
  min-height: 100vh;
  background: #f7f7f9;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.header { padding: 8rpx 4rpx 32rpx; }
.title { display: block; font-size: 40rpx; font-weight: 600; color: #1a1a1a; }
.subtitle { display: block; margin-top: 8rpx; font-size: 24rpx; color: #8a8a8f; }

.actions { display: flex; gap: 20rpx; }
.btn {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 44rpx 0 34rpx;
  text-align: center;
  border: 2rpx solid #ececf0;
}
.btn-primary { background: #1a1a1a; border-color: #1a1a1a; }
.btn-primary .btn-text { color: #fff; }
.btn-primary .btn-icon { color: #fff; }
.btn-primary .btn-hint { color: rgba(255,255,255,0.55); }
.btn.disabled { opacity: 0.45; }
.btn-icon { display: block; font-size: 48rpx; color: #1a1a1a; line-height: 1; }
.btn-text { display: block; margin-top: 16rpx; font-size: 30rpx; font-weight: 500; color: #1a1a1a; }
.btn-hint { display: block; margin-top: 6rpx; font-size: 22rpx; color: #a0a0a8; }

.jobs { margin-top: 36rpx; background: #fff; border-radius: 20rpx; padding: 24rpx; }
.jobs-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12rpx; }
.jobs-title { font-size: 28rpx; font-weight: 600; color: #1a1a1a; }
.jobs-stat { font-size: 24rpx; color: #8a8a8f; }

.job { display: flex; align-items: flex-start; padding: 18rpx 0; border-top: 2rpx solid #f2f2f5; }
.job:first-of-type { border-top: none; }
.job-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  margin: 12rpx 18rpx 0 2rpx; flex-shrink: 0; background: #c8c8ce;
}
.job-uploading .job-dot { background: #f0a020; }
.job-done .job-dot { background: #2fb344; }
.job-deduped .job-dot { background: #6a9ae0; }
.job-failed .job-dot { background: #d64545; }

.job-body { flex: 1; min-width: 0; }
.job-name {
  display: block; font-size: 26rpx; color: #333;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.job-msg { display: block; margin-top: 6rpx; font-size: 22rpx; color: #9a9aa0; word-break: break-all; }
.job-failed .job-msg { color: #c0392b; }
.job-done .job-msg { color: #2fb344; }
.job-deduped .job-msg { color: #4a7fc4; }

.go-btn {
  margin-top: 24rpx; padding: 22rpx 0; text-align: center;
  background: #f2f2f5; border-radius: 999rpx;
  font-size: 28rpx; color: #1a1a1a;
}

.tips { margin-top: 40rpx; padding: 28rpx; background: #fff; border-radius: 20rpx; }
.tips-title { display: block; font-size: 26rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 14rpx; }
.tips-line { display: block; font-size: 24rpx; line-height: 1.9; color: #8a8a8f; }
