.page {
  min-height: 100vh;
  background: #f7f7f9;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.header { padding: 8rpx 4rpx 32rpx; }
.title { display: block; font-size: 40rpx; font-weight: 600; color: #1a1a1a; }
.subtitle { display: block; margin-top: 8rpx; font-size: 24rpx; color: #8a8a8f; }

.card { background: #fff; border-radius: 20rpx; padding: 28rpx; }

.row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20rpx; }
.row-label { font-size: 26rpx; color: #8a8a8f; }
.row-value { font-size: 28rpx; color: #1a1a1a; font-family: monospace; }
.row-value.empty { color: #c0392b; font-family: inherit; }

.input {
  background: #f2f2f5;
  border-radius: 14rpx;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: #1a1a1a;
}
.input-ph { color: #b0b0b8; }

.btns { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 999rpx;
  background: #f2f2f5;
  font-size: 28rpx;
  color: #1a1a1a;
}
.btn-primary { background: #1a1a1a; color: #fff; }
.btn.disabled { opacity: 0.5; }

.check-result {
  display: block;
  margin-top: 22rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #555;
  word-break: break-all;
}

.go {
  margin-top: 24rpx; padding: 22rpx 0; text-align: center;
  background: #f2f2f5; border-radius: 999rpx;
  font-size: 28rpx; color: #1a1a1a;
}

.tips { margin-top: 32rpx; padding: 28rpx; background: #fff; border-radius: 20rpx; }
.tips-title { display: block; font-size: 26rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 14rpx; }
.tips-line { display: block; font-size: 24rpx; line-height: 1.9; color: #8a8a8f; }

.env { margin-top: 28rpx; text-align: center; }
.env-text { font-size: 20rpx; color: #b8b8c0; }
